# Copy these variables into your process manager or deployment environment.
# Node does not load this file automatically.

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
GOVERNANCE_DATA_DIR=./data

# Set a cryptographically random value (at least 32 bytes) before production.
# BOOTSTRAP_TOKEN=

# Optional OpenAI-compatible AI analysis provider.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Optional ClamAV scanner. Evidence is not release-eligible until clean.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Optional GitHub App installation token and repository.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_WEBHOOK_SECRET=

# Optional HMAC-SHA256 signed CI coverage reporting.
# CI_WEBHOOK_SECRET=

# Only set in production behind a TLS-terminating reverse proxy.
# NODE_ENV=production
# TRUST_PROXY=1
